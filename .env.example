# --- PostgreSQL ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password123
POSTGRES_DB=devops_incident_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres_user:postgres_password123@db:5432/devops_incident_db

# --- Weaviate (búsqueda semántica) ---
WEAVIATE_HOST=weaviated

# --- JWT ---
# Clave para firmar los tokens. Genera una propia en producción, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_in_production

# --- LANGFUSE (Observabilidad) - reemplazar con claves reales ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
